            <actions>
              <action id="329" beanClass="com.install4j.runtime.beans.actions.control.RunScriptAction" commentSet="true" comment="Removes all JAR files in the installation directory (previous versions)." rollbackBarrierExitCode="0">
                <serializedBean>
                  <property name="script">
                    <object class="com.install4j.api.beans.ScriptProperty">
                      <property name="value" type="string">File[] files = context.getInstallationDirectory().listFiles();
ArrayList&lt;String&gt; filesToDelete = new ArrayList&lt;&gt;();

if (files == null) return true;

for (int i = 0; i &lt; files.length; i++) {
    if (files[i].getName().endsWith(".jar")) {
        filesToDelete.add(files[i].getAbsolutePath());
    }
}

context.setVariable("oldjarstodelete", filesToDelete.toArray());

return true;</property>
                    </object>
                  </property>
                </serializedBean>
              </action>
