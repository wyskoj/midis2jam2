// Polished brass: a sphere-mapped reflection over a black base. Matches AssetLoader.reflectiveMaterial.
Material HornSkin : Assets/MatDefs/Lighting.j3md {
    MaterialParameters {
        DiffuseMap : Flip Assets/Textures/Shared/Black.bmp
        EnvMap : Flip Assets/Textures/Shared/HornSkin.bmp
        EnvMapAsSphereMap : true
        FresnelParams : 0.18 0.18 0.18
    }
}
